generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id           String   @id @default(cuid())
  name         String
  email        String
  comment      String
  web          String?
  status       String   @default("PENDING")
  replyMessage String?
  createdAt    DateTime @default(now())
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  dni       String   @unique
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  results   Result[]
}

model Result {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  patientId String
  createdAt DateTime @default(now())
  patient   Patient  @relation(fields: [patientId], references: [id])
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  role      Role     @default(USER)
  active    Boolean  @default(true)
}

model PrpAppointment {
  id           String   @id @default(cuid())
  email        String
  professional String?
  patient      String
  date         String
  time         String
  preparation  String[]
  status       String   @default("SCHEDULED")
  createdAt    DateTime @default(now())
  cancelReason String?
}

model Derivacion {
  id           String   @id @default(cuid())
  email        String
  labName      String?
  patient      String
  date         String
  time         String
  analysisType String[]
  status       String   @default("SCHEDULED")
  cancelReason String?
  createdAt    DateTime @default(now())
}

model VeterinaryAppointment {
  id           String   @id @default(cuid())
  email        String
  veterinary   String
  professional String
  patient      String
  analysis     String[]
  other        String?
  status       String   @default("PENDING")
  cancelReason String?
  createdAt    DateTime @default(now())
}

model AnalysisPrice {
  id        String   @id @default(cuid())
  name      String   @unique
  nbuUnits  Float
  category  String?  @default("DERIVANTE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

enum Role {
  ADMIN
  USER
  SECRETARY
}
