generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  comment   String
  web       String?
  createdAt DateTime @default(now())
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  dni       String   @unique
  email     String?
  phone     String?
  results   Result[]
  createdAt DateTime @default(now())
}

model Result {
  id        String   @id @default(cuid())
  title     String
  fileUrl   String
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  createdAt DateTime @default(now())
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}
